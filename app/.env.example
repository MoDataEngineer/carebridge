# CareBridge — environment template
# Copy to `.env` (root) and `app/.env` as needed and fill real values.
# NEVER commit a filled-in .env. Only this .example file is tracked.
# Client-safe values (anon key) may ship to the Flutter app; everything
# marked SERVER-ONLY must live in Supabase secrets, never in the client bundle.

# ---- Supabase (client-safe) ----
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# ---- Supabase (SERVER-ONLY — Edge Functions / migrations) ----
SUPABASE_SERVICE_ROLE_KEY=server-only-do-not-ship-to-client
SUPABASE_JWT_SECRET=server-only-used-to-mint-scoped-tokens   # D2 scope-token signing

# ---- Feature flags ----
REQUIRE_ABHA=false          # D3: flip to true once real ABDM integration lands (Phase 11)

# ---- Firebase Phone OTP (Phase 11, client-safe web-app config) ----
# From Firebase console -> Project settings -> General -> Your apps -> Web app.
# All four present = real OTP flows switch on; absent = demo (no-OTP) login.
# Server side: set REQUIRE_OTP=true in Supabase secrets to REFUSE demo logins.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- Claude API (SERVER-ONLY — ai-summary Edge Function, Phase 7) ----
ANTHROPIC_API_KEY=server-only-claude-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Firebase Cloud Messaging (Phase 8) ----
FCM_SERVER_KEY=server-only-fcm-key
FCM_PROJECT_ID=your-fcm-project-id

# ---- ABDM / ABHA / HPR / HFR sandbox (Phase 11 — placeholder/mocked for now) ----
ABDM_CLIENT_ID=sandbox-client-id
ABDM_CLIENT_SECRET=server-only-sandbox-secret
ABDM_BASE_URL=https://dev.abdm.gov.in
