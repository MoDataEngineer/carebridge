# ---- Secrets / env (never commit) ----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Supabase local secrets & state
supabase/.branches/
supabase/.temp/
supabase/.env
**/service-role-key*
**/*secret*
!*.example

# ---- Flutter / Dart ----
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/build/
app/.pub-cache/
app/.pub/
# pubspec.lock IS committed on purpose (app, not a library): reproducible builds
# + a pinned record so a compromised dependency point-release can't slip in
# silently (security review 2026-07-19, H4).
app/coverage/
**/*.g.dart.lock

# Generated / build artifacts
build/
**/build/
*.iml
.idea/
.vscode/
*.log

# Platform folders (regenerated by `flutter create .`)
app/android/
app/ios/
app/linux/
app/macos/
app/windows/
app/web/

# OS noise
.DS_Store
Thumbs.db

# Personal/local Claude Code settings
.claude/settings.local.json
